{
  "name": "vessel-app",
  "version": "0.1.0-beta.13",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "test:ui": "playwright test",
    "prepare:native": "node scripts/prepare-native.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "package:macos": "npm run tauri -- build --bundles app && node scripts/package-macos.mjs",
    "package:windows": "npm run tauri -- build --bundles nsis && node scripts/package-windows.mjs",
    "release:macos": "npm run tauri -- build --bundles app && node scripts/package-macos.mjs --distribution",
    "verify:macos": "node scripts/check-macos-package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "1.61.0",
    "@tauri-apps/api": "2.12.4",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
